generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  userName      String    @unique
  firstName     String
  lastName      String
  passwordHash  String?
  avatarUrl     String?
  images        Image[]
  comments      Comment[]
  likes         Like[]
  palettes      Palette[]
}

model Image {
  id          Int       @id @default(autoincrement())
  userId      Int
  name        String
  description String
  imageUrl    String
  likes       Int       @default(0)
  views       Int       @default(0)
  user        User      @relation(fields: [userId], references: [id])
  comments    Comment[]
  likedBy     Like[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int
  imageId   Int
  comment   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  image     Image    @relation(fields: [imageId], references: [id])
}

model Like {
  id      Int   @id @default(autoincrement())
  userId  Int
  imageId Int
  user    User  @relation(fields: [userId], references: [id])
  image   Image @relation(fields: [imageId], references: [id])

  @@unique([userId, imageId])
}

model Palette {
  id      Int      @id @default(autoincrement())
  userId  Int
  name    String
  colors  String[]
  user    User     @relation(fields: [userId], references: [id])
}
